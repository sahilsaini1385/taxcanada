# Copy to .env.local for local development.
# The app runs fine WITHOUT these — Google sign-in is simply hidden until
# credentials are configured. Everything else works anonymously.

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# http://localhost:3000 locally; your production URL on Vercel
NEXTAUTH_URL=http://localhost:3000

# From Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
# Authorized redirect URI: <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
